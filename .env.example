# API des liens courts. Ne pas définir la variable = pas de lien court (site statique seul).
# Vide = même origine (`/api` : proxy Vite en dev, route Worker en prod).
# Absolue = Worker sur un autre domaine (penser à ALLOWED_ORIGINS côté Worker).
# VITE_API_URL=
# VITE_API_URL=https://simulateur-flux-api.<compte>.workers.dev

# Suivi d'erreurs Sentry (optionnel). Absent = SDK jamais chargé.
# VITE_SENTRY_DSN=https://<clé>@<org>.ingest.sentry.io/<projet>

# Audience Plausible, sans cookie (optionnel). URL du script donnée par Plausible → Site installation.
# VITE_PLAUSIBLE_SRC=https://plausible.io/js/pa-XXXXXXXX.js
